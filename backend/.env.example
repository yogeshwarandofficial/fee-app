# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret — use a long, random string in production
JWT_SECRET=your_jwt_secret_here

# HTTP port the server will listen on
PORT=5000

# Admin credentials — used only by the seedAdmin.js script (run once)
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=admin123


# AI integration (future use)
AI_API_KEY=your_ai_api_key_here
AI_PROVIDER=openai

# WhatsApp integration (future use)
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_API_SECRET=your_whatsapp_api_secret_here
